{
  "manifest_version": 3,
  "name": "avo",
  "version": "1.0.0",
  "description": "AI-powered page analyzer - ask questions about any webpage content",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://openrouter.io/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "avo - AI Page Assistant"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
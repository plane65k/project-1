{
  "manifest_version": 3,
  "name": "avo",
  "version": "2.1.0",
  "description": "AI page analyzer powered by OpenRouter",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": [
    "<all_urls>",
    "https://openrouter.ai/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "avo - AI Page Analyzer"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
